@model ApprenticeshipManagement.ViewModels.AdminHomeModel
@{
    ViewData["Title"] = "Administrator Panel";
}

<div class="admin-page">
    <div class="admin-top white-box p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <h1 class="page-head mb-0">Administrator Panel</h1>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-logout">Logout</button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="white-box p-4 mb-4">
        <div class="row align-items-center g-4">
            <div class="col-md-4">
                <div class="user-row d-flex align-items-center gap-3">
                    <div class="user-img">&#128100;</div>
                    <div>
                        <h4 class="mb-0">@Model.AdminName</h4>
                        <p class="gray-txt mb-0">System Administrator</p>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="info-box">
                            <div class="info-lbl">Total Apprentices</div>
                            <div class="info-val">@Model.TotalApprentices</div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="info-box">
                            <div class="info-lbl">Active Apprentices</div>
                            <div class="info-val text-success">@Model.ActiveApprentices</div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="info-box">
                            <div class="info-lbl">Inactive Apprentices</div>
                            <div class="info-val text-danger">@Model.InactiveApprentices</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="white-box p-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
            <h3 class="sec-title mb-0">Manage Apprentices</h3>
            <a asp-action="Add" class="btn btn-add">
                <i class="bi bi-person-plus"></i> Add Student
            </a>
        </div>

        <form asp-action="Index" method="get" class="search-row mb-4" id="adminSearchForm">
            <input type="text" name="search" id="adminSearchInput" value="@Model.SearchQuery" class="form-control"
                   placeholder="Search by name, ID, email, phone, or trade..." autocomplete="off" />
            <button type="submit" class="btn btn-find">Search</button>
            <a asp-action="Index" class="btn btn-reset" id="adminSearchClear">Clear</a>
        </form>

        <div class="table-responsive">
            <table class="table tbl mb-0">
                <thead>
                    <tr>
                        <th>Apprentice ID</th>
                        <th>Full Name</th>
                        <th>Trade/Field</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Apprentices.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center gray-txt py-4">
                                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                                {
                                    <text>No students match your search. Try another term or click Clear to show all.</text>
                                }
                                else
                                {
                                    <text>No apprentices found. Add a student or register new apprentices.</text>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in Model.Apprentices)
                        {
                            <tr>
                                <td>@a.ApprenticeId</td>
                                <td>@a.FullName</td>
                                <td>@a.TradeField</td>
                                <td>@a.Email</td>
                                <td>@a.Phone</td>
                                <td>
                                    @if (a.IsActive)
                                    {
                                        <span class="st-on">Active</span>
                                    }
                                    else
                                    {
                                        <span class="st-off">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="tbl-btns">
                                        <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-vw">View</a>
                                        <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-ed">Edit</a>
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@a.Id" />
                                            @if (a.IsActive)
                                            {
                                                <button type="submit" class="btn btn-warn">Deactivate</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-ok">Activate</button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('adminSearchForm');
            const input = document.getElementById('adminSearchInput');
            const clearUrl = '@Url.Action("Index", "Admin")';
            if (!form || !input) return;

            const params = new URLSearchParams(window.location.search);
            const hadActiveSearch = Boolean(params.get('search')?.trim());

            form.addEventListener('submit', function (e) {
                if (!input.value.trim()) {
                    e.preventDefault();
                    window.location.href = clearUrl;
                }
            });

            let clearTimer;
            input.addEventListener('input', function () {
                clearTimeout(clearTimer);
                if (hadActiveSearch && !input.value.trim()) {
                    clearTimer = setTimeout(function () {
                        window.location.href = clearUrl;
                    }, 400);
                }
            });
        })();
    </script>
}
